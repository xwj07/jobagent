# Copy to .env and fill in. Never commit .env.
JOBAGENT_DATABASE_URL=sqlite:///./jobagent.db
# For Postgres instead:
# JOBAGENT_DATABASE_URL=postgresql+psycopg://jobagent:jobagent@localhost:5432/jobagent

# LLM provider: "openai" (any OpenAI-compatible endpoint) or "mock" (offline, no key needed)
JOBAGENT_PROVIDER=openai
JOBAGENT_LLM_BASE_URL=https://ai.gitee.com/v1
JOBAGENT_LLM_API_KEY=
JOBAGENT_LLM_MODEL=DeepSeek-V4-Pro-0813
JOBAGENT_AUDIO_MODEL=Qwen3.8-Omni-Flash
